{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mewtrucard-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "CF_ACCOUNT_ID": "e2bf13917f6dff565f6357f7237ce9fa",
    "NEXT_PUBLIC_BASE_URL": "https://mewtrucard-preview.auroroa.workers.dev/",
    "NEXT_PUBLIC_SITE_URL": "https://mewtrucard-preview.auroroa.workers.dev/",
    "NEXTAUTH_URL": "https://mewtrucard-preview.auroroa.workers.dev/",
    "AUTH_URL": "https://mewtrucard-preview.auroroa.workers.dev/",
    // Stripe price ids are public identifiers, not secrets: keeping them here
    // pins preview to the test catalog and production to the live one.
    "STRIPE_PLUS_MONTHLY_PRICE_ID": "price_1UB7uTI54muVmsd9fqvFF7pH",
    "STRIPE_PLUS_YEARLY_PRICE_ID": "price_1UB7uUI54muVmsd9pI0zuZ1w",
    "STRIPE_CREATOR_PRO_MONTHLY_PRICE_ID": "price_1UB7uWI54muVmsd9SzU2PJpT",
    "STRIPE_CREATOR_PRO_YEARLY_PRICE_ID": "price_1UB7uXI54muVmsd91NMYtQeF",
      "STRIPE_PACK_20_PRICE_ID": "price_1UB8CnI54muVmsd9Fs7qe2DU",
      "STRIPE_PACK_50_PRICE_ID": "price_1UB8CoI54muVmsd91HikByKu"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mewtrucard-preview"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "mewtrucard-next-cache-preview"
    },
    {
      "binding": "CARD_ASSETS_BUCKET",
      "bucket_name": "celeprime"
    }
  ],
  "env": {
    "production": {
      "name": "mewtrucard",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "mewtrucard.com",
          "custom_domain": true
        },
        {
          "pattern": "www.mewtrucard.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "CF_ACCOUNT_ID": "e2bf13917f6dff565f6357f7237ce9fa",
        "NEXT_PUBLIC_BASE_URL": "https://mewtrucard.com/",
        "NEXT_PUBLIC_SITE_URL": "https://mewtrucard.com/",
        "NEXTAUTH_URL": "https://mewtrucard.com/",
        "AUTH_URL": "https://mewtrucard.com/",
        "STRIPE_PLUS_MONTHLY_PRICE_ID": "price_1UB7xfG3yT9HLPAs96NP0xnO",
        "STRIPE_PLUS_YEARLY_PRICE_ID": "price_1UB7xfG3yT9HLPAs5Xux0UQ8",
        "STRIPE_CREATOR_PRO_MONTHLY_PRICE_ID": "price_1UB7xhG3yT9HLPAsgtDpTRHr",
        "STRIPE_CREATOR_PRO_YEARLY_PRICE_ID": "price_1UB7xiG3yT9HLPAsdek8GLyC",
        "STRIPE_PACK_20_PRICE_ID": "price_1UB8GUG3yT9HLPAsSmT075ng",
        "STRIPE_PACK_50_PRICE_ID": "price_1UB8GUG3yT9HLPAsQphkjyQE"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "mewtrucard"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "mewtrucard-next-cache"
        },
        {
          "binding": "CARD_ASSETS_BUCKET",
          "bucket_name": "celeprime"
        }
      ]
    }
  }
}
